# Production accepts plaintext NVS so it never needs an irreversible eFuse key.
CONFIG_NVS_ENCRYPTION=n
CONFIG_SECURE_BOOT=n
CONFIG_SECURE_FLASH_ENC_ENABLED=n
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=n
CONFIG_BOOTLOADER_ANTI_ROLLBACK_ENABLE=n
CONFIG_SECURE_FLASH_PSEUDO_ROUND_FUNC=n
CONFIG_SECURE_DISABLE_ROM_DL_MODE=n
CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE=n
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Production uses the reviewed PSRAM part. Skip its optional full-memory start
# test and optimize the bootloader for speed. Development keeps the test.
CONFIG_SPIRAM_MEMTEST=n
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=n
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
